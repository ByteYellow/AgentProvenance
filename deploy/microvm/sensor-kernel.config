# Native Sensor requirements added to the pinned upstream microVM configuration.
CONFIG_BPF_JIT=y
CONFIG_KPROBES=y
CONFIG_UPROBES=y
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
# CONFIG_DEBUG_INFO_NONE is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# Boot and collection drivers must be built in; the rootfs has no module tree.
# CONFIG_MODULES is not set
# CONFIG_BPF_PRELOAD is not set
CONFIG_LOCALVERSION="-agentprov"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_BUILD_SALT="agentprov-microvm"
